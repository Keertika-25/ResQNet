# Copy to backend/.env and adjust. Loaded with: uvicorn app.main:app --env-file .env
# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Login token lifetime in minutes
ACCESS_TOKEN_MINUTES=480
# SQLite file (default: backend/resqnet.db)
# DATABASE_URL=sqlite:///./resqnet.db
# Comma-separated origins allowed to call the API directly (the Vite dev proxy doesn't need this)
CORS_ORIGINS=http://localhost:5173
# Populate demo data automatically when the database is empty
SEED_ON_STARTUP=true
# Allow dispatchers to reset all data to the demo dataset (POST /api/demo/reset)
DEMO_MODE=true
